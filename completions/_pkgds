#compdef pkgds

autoload -U is-at-least

_pkgds() {
    typeset -A opt_args
    typeset -a _arguments_options
    local ret=1

    if is-at-least 5.2; then
        _arguments_options=(-s -S -C)
    else
        _arguments_options=(-s -C)
    fi

    local context curcontext="$curcontext" state line
    _arguments "${_arguments_options[@]}" : \
'-H+[Human-size unit (B, K, Ki, M, Mi, G, Gi, T, Ti, auto, auto-si; default\: raw in format mode, auto in table mode)]:HUMANSIZE:(B K Ki M Mi G Gi T Ti auto auto-si)' \
'-s+[Search packages by regex on name]:SEARCH:_default' \
'--search=[Search packages by regex on name]:SEARCH:_default' \
'--sort=[Sort by field\: name (ascending), real (alias size)/apparent/files (descending), ratio (ascending; requires --btrfs)]:SORT:(name real size apparent files ratio)' \
'-n+[Show only top N packages (0 = unlimited; default 20 in table mode, unlimited in format mode)]:LIMIT:_default' \
'--limit=[Show only top N packages (0 = unlimited; default 20 in table mode, unlimited in format mode)]:LIMIT:_default' \
'--root=[Set filesystem root prefix]:ROOT:_files' \
'--dbpath=[Override pacman local DB path (absolute)]:DBPATH:_files' \
'-d+[Delimiter between packages in format mode (default\: newline; used literally, use -d \$'\''\\t'\'' for tab)]:DELIM:_default' \
'--depth=[Tree depth in levels (implies --tree; default 1)]:DEPTH:_default' \
'--breadth=[Show at most K children per directory (default 5; requires --tree)]:BREADTH:_default' \
'--min-percent=[Prune entries below this percentage of their parent (requires --tree; default 0.1)]:MIN_PERCENT:_default' \
'--btrfs[Enable btrfs on-disk size tokens (%z, %r)]' \
'-v[Show warnings for missing files, permission errors]' \
'--verbose[Show warnings for missing files, permission errors]' \
'--no-color[Disable color output]' \
'--apparent-size[Show apparent file size instead of disk blocks (du --apparent-size)]' \
'--total[Show total row at the bottom of table output]' \
'--files[Show file count column]' \
'--tree[Show a per-package file/dir tree (default depth 1)]' \
'--with-deps[With targets include freed dependencies; bare ranks all packages by freed space (table only)]' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
'-V[Print version]' \
'--version[Print version]' \
'*::positional -- Format string (printf-style) or package names:_default' \
&& ret=0
}

(( $+functions[_pkgds_commands] )) ||
_pkgds_commands() {
    local commands; commands=()
    _describe -t commands 'pkgds commands' commands "$@"
}

if [ "$funcstack[1]" = "_pkgds" ]; then
    _pkgds "$@"
else
    compdef _pkgds pkgds
fi
